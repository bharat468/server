// Prisma schema for RENTMATE backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PropertyStatus {
  VACANT
  OCCUPIED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum UnitStatus {
  VACANT
  LISTED
  APPLICATION_PENDING
  OCCUPIED
  MAINTENANCE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
}

enum ScheduleStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                  String               @id @default(uuid())
  mobile              String               @unique
  email               String?              @unique
  name                String?
  avatar              String?
  status              UserStatus           @default(ACTIVE)
  isSuperAdmin        Boolean              @default(false)
  adminRole           String?
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relationships
  ownedOrganizations         Organization[]       @relation("OrganizationOwner")
  organizationMembers        OrganizationMember[]
  userRoles                  UserRole[]
  properties                 Property[]           @relation("UserProperties")
  createdProperties          Property[]           @relation("PropertyCreatedBy")
  applications               RentalApplication[]
  tenantLeases               Lease[]              @relation("TenantLeases")
  tenantMaintenanceRequests  MaintenanceRequest[] @relation("TenantMaintenanceRequests")
  staffAssignedRequests      MaintenanceRequest[] @relation("StaffAssignedRequests")
  actorAuditLogs             AuditLog[]           @relation("ActorAuditLogs")

  @@map("users")
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  ownerId   String
  owner     User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  members       OrganizationMember[]
  roles         Role[]
  userRoles     UserRole[]
  properties    Property[]
  subscriptions Subscription[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Otp {
  id        String   @id @default(uuid())
  mobile    String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile])
  @@map("otps")
}

model Role {
  id             String           @id @default(uuid())
  name           String
  slug           String
  description    String?
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyScope  String[]     @default([]) // Specific property IDs, empty array = full organization access
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

model Property {
  id             String         @id @default(uuid())
  title          String
  address        String
  city           String
  rent           Float
  bedrooms       Int            @default(1)
  status         PropertyStatus @default(VACANT)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?          @relation("UserProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?          @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenants             Tenant[]
  payments            Payment[]
  units               Unit[]
  listings            RentalListing[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@map("properties")
}

model Tenant {
  id          String    @id @default(uuid())
  name        String
  email       String
  phone       String
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leaseStart  String?
  leaseEnd    String?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments    Payment[]

  @@map("tenants")
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount      Float
  month       String
  status      PaymentStatus @default(PENDING)
  paidOn      DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  priceMonthly  Float          @default(0)
  priceYearly   Float          @default(0)
  maxProperties Int            @default(5)
  maxTenants    Int            @default(10)
  maxStaff      Int            @default(2)
  features      String[]       @default([])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  status         String       @default("ACTIVE")
  startDate      DateTime     @default(now())
  endDate        DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("subscriptions")
}

model SuperAdminRole {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("superadmin_roles")
}

model Unit {
  id             String         @id @default(uuid())
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitNumber     String
  floor          Int            @default(1)
  type           String         @default("FLAT_2BHK")
  areaSqFt       Float?
  rentAmount     Float
  depositAmount  Float          @default(0)
  furnishing     String         @default("SEMI_FURNISHED")
  status         UnitStatus     @default(VACANT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  listings            RentalListing[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, unitNumber])
  @@map("units")
}

model RentalListing {
  id              String         @id @default(uuid())
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String         @default("RESIDENTIAL")
  monthlyRent     Float
  securityDeposit Float
  furnishing      String?
  availableFrom   DateTime?
  amenities       String[]       @default([])
  photos          String[]       @default([])
  isPublished     Boolean        @default(true)
  status          ListingStatus  @default(PUBLISHED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  applications    RentalApplication[]

  @@map("rental_listings")
}

model RentalApplication {
  id              String            @id @default(uuid())
  listingId       String
  listing         RentalListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String
  occupation      String?
  message         String?
  proposedMoveIn  DateTime?
  status          ApplicationStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewerNotes   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lease           Lease?

  @@map("rental_applications")
}

model Lease {
  id              String             @id @default(uuid())
  propertyId      String
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          User               @relation("TenantLeases", fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId   String?            @unique
  application     RentalApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Float
  securityDeposit Float
  depositPaid     Float              @default(0)
  depositStatus   String             @default("PENDING")
  status          LeaseStatus        @default(ACTIVE)
  terms           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  rentRule        RentRule?
  schedules       RentSchedule[]

  @@map("leases")
}

model RentRule {
  id             String         @id @default(uuid())
  leaseId        String         @unique
  lease          Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  frequency      String         @default("MONTHLY")
  dueDay         Int            @default(5)
  graceDays      Int            @default(3)
  penaltyType    String         @default("PER_DAY")
  penaltyAmount  Float          @default(100)
  maxPenaltyCap  Float          @default(2000)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("rent_rules")
}

model RentSchedule {
  id             String         @id @default(uuid())
  leaseId        String
  lease          Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  period         String
  dueDate        DateTime
  amount         Float
  paidAmount     Float          @default(0)
  penaltyAmount  Float          @default(0)
  status         ScheduleStatus @default(UPCOMING)
  paidOn         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("rent_schedules")
}

model MaintenanceRequest {
  id              String              @id @default(uuid())
  propertyId      String
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenantId        String
  tenant          User                @relation("TenantMaintenanceRequests", fields: [tenantId], references: [id], onDelete: Cascade)
  assignedStaffId String?
  assignedStaff   User?               @relation("StaffAssignedRequests", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  title           String
  description     String
  category        String              @default("PLUMBING")
  priority        MaintenancePriority @default(MEDIUM)
  status          MaintenanceStatus   @default(OPEN)
  cost            Float               @default(0)
  notes           String?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("maintenance_requests")
}

model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?
  actor      User?     @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("PLATFORM_GENERAL")
  description String?
  unit        String?
  dataType    String   @default("string")
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("system_settings")
}

